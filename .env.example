POSTGRES_DB=jie
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/jie
REDIS_URL=redis://redis:6379/0
API_PREFIX=
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

CLEARBIT_API_KEY=
LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434/api/generate
LOCAL_LLM_MODEL=llama3.2:3b

NEXT_PUBLIC_API_BASE=http://localhost:8000
METRICS_ENABLED=true
SOURCE_ENABLE_PROXY_ROTATION=false
SOURCE_PROXIES=
SOURCE_PROXY_MAX_FAILURES=3
SOURCE_PROXY_COOLDOWN_SECONDS=180
SOURCE_PROXY_STICKY_MINUTES=10
SOURCE_CHALLENGE_SOLVER_ENABLED=false
SOURCE_CHALLENGE_SOLVER_PROVIDER=signed_http_v1
SOURCE_CHALLENGE_SOLVER_ENDPOINT=
SOURCE_CHALLENGE_SOLVER_API_KEY=
SOURCE_CHALLENGE_SOLVER_SIGNING_SECRET=
SOURCE_CHALLENGE_RESPONSE_MAX_SKEW_SECONDS=120
SOURCE_CHALLENGE_RETRY_LIMIT=1
